[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/28/2026,0.2.0.0
CatalogFile=FlowBridgeWfp.cat
PnpLockdown=1

[DefaultInstall.NTamd64]
CopyFiles=DriverCopy

[DefaultInstall.NTamd64.Services]
