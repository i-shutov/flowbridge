+LRESULT CALLBACK buttonEnterProc(HWND h,UINT msg,WPARAM w,LPARAM l,UINT_PTR id,DWORD_PTR) {
+    if(msg==WM_GETDLGCODE) {
+        auto code=DefSubclassProc(h,msg,w,l);
+        auto key=reinterpret_cast<const MSG*>(l);
+        if(key && key->message==WM_KEYDOWN && key->wParam==VK_RETURN) code|=DLGC_WANTMESSAGE;
+        return code;
+    }
+    if(msg==WM_KEYDOWN && w==VK_RETURN) {
+        if(!(l & (1LL<<30)) && IsWindowEnabled(h)) SendMessageW(h,BM_CLICK,0,0);
+        return 0;
+    }
+    if(msg==WM_NCDESTROY) RemoveWindowSubclass(h,buttonEnterProc,id);
+    return DefSubclassProc(h,msg,w,l);
+}
